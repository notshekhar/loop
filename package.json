{
    "name": "loop-monorepo",
    "private": true,
    "type": "module",
    "workspaces": {
        "packages": [
            "packages/*",
            "apps/*"
        ],
        "catalog": {
            "@clerk/electron": "0.0.24",
            "@clerk/react": "6.12.9",
            "@clerk/shared": "4.25.9",
            "@effect/atom-react": "4.0.0",
            "@effect/platform-node": "4.0.0",
            "@effect/tsgo": "0.13.2",
            "@effect/vitest": "4.0.0",
            "@noble/curves": "1.9.1",
            "@noble/hashes": "1.8.0",
            "@pierre/diffs": "1.3.0-beta.10",
            "@typescript/native-preview": "7.0.0-dev.20260604.1",
            "effect": "4.0.0",
            "jose": "6.2.2",
            "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
            "vite-plus": "0.2.2",
            "yaml": "^2.9.0"
        }
    },
    "//trustedDependencies": "bun skips postinstall scripts unless a package is listed here. electron ships only a JS shim without its postinstall and fails at launch with 'Electron failed to install correctly'.",
    "trustedDependencies": [
        "electron",
        "node-pty"
    ],
    "patchedDependencies": {
        "@effect/vitest@4.0.0": "patches/@effect__vitest@4.0.0.patch",
        "@pierre/diffs@1.3.0-beta.10": "patches/@pierre%2Fdiffs@1.3.0-beta.10.patch",
        "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
        "@expo/metro-config@56.0.14": "patches/@expo%2Fmetro-config@56.0.14.patch",
        "@legendapp/list@3.3.3": "patches/@legendapp__list@3.3.3.patch",
        "@react-native-menu/menu@2.0.0": "patches/@react-native-menu__menu@2.0.0.patch",
        "@react-navigation/native-stack@7.17.6": "patches/@react-navigation%2Fnative-stack@7.17.6.patch",
        "expo-modules-jsi@56.0.10": "patches/expo-modules-jsi@56.0.10.patch",
        "react-native-gesture-handler@2.31.2": "patches/react-native-gesture-handler@2.31.2.patch",
        "react-native-keyboard-controller@1.21.13": "patches/react-native-keyboard-controller@1.21.13.patch",
        "react-native-nitro-modules@0.35.9": "patches/react-native-nitro-modules@0.35.9.patch",
        "react-native-screens@4.25.2": "patches/react-native-screens@4.25.2.patch"
    },
    "overrides": {
        "@effect/atom-react": "4.0.0",
        "@effect/platform-node": "4.0.0",
        "@effect/vitest": "4.0.0",
        "effect": "4.0.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.2.2",
        "@expo/metro-config": "56.0.14",
        "expo-modules-jsi": "56.0.10"
    },
    "scripts": {
        "dev": "bun packages/cli/src/cli.ts",
        "build": "bun run gen:catalog && bun run gen:docs && bun run --filter @notshekhar/loop-sandbox build && bun run --filter @loop/web build && bun run --filter @notshekhar/loop-core build && bun run --filter @notshekhar/loop-tui build && bun run --filter @notshekhar/loop build",
        "gen:catalog": "bun packages/core/src/catalog/scripts/generate.ts",
        "gen:docs": "bun packages/core/src/docs/scripts/generate.ts",
        "site:docs": "bun scripts/build-docs.ts",
        "bump": "bun scripts/bump-version.ts",
        "link": "bun run --filter @notshekhar/loop build && cd packages/cli && bun link",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "//typecheck": "Every bundler here transpiles without checking, so a type error reaches a release unless this runs. tsgo for the two app packages, tsc for the rest.",
        "typecheck": "bun scripts/typecheck.ts",
        "//test": "Scoped: a bare `bun test` also collects apps/web, whose suite is vitest-only and hangs the process under bun. The web app has its own `test` script.",
        "test": "bun run typecheck && bun test packages apps/desktop && bun run --filter @loop/web test && bun run --filter @loop/mobile test",
        "//test:screens": "Runs loop in a real pty and asserts on the screen \u2014 the only tests that catch a correct frame drawn in the wrong place.",
        "test:screens": "bun packages/cli/test/e2e/run.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.1.1",
        "prettier": "^3.9.5"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "packageManager": "bun@1.4.0"
}
